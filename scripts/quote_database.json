  "marcus_aurelius": [
    {
      "id": "MA01",
      "quote": "You have power over your mind, not outside events. Realize this, and you will find strength.",
      "source": "Meditations",
      "theme": ["resilience", "mindset", "control"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA02",
      "quote": "The happiness of your life depends upon the quality of your thoughts.",
      "source": "Meditations",
      "theme": ["happiness", "mindset", "thoughts"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA03",
      "quote": "Waste no more time arguing about what a good man should be. Be one.",
      "source": "Meditations",
      "theme": ["action", "virtue", "discipline"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA04",
      "quote": "The best revenge is to be unlike him who performed the injury.",
      "source": "Meditations",
      "theme": ["revenge", "character", "resilience"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA05",
      "quote": "Very little is needed to make a happy life; it is all within yourself, in your way of thinking.",
      "source": "Meditations",
      "theme": ["happiness", "simplicity", "mindset"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA06",
      "quote": "When you arise in the morning, think of what a precious privilege it is to be alive.",
      "source": "Meditations",
      "theme": ["gratitude", "morning", "perspective"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA07",
      "quote": "The soul becomes dyed with the colour of its thoughts.",
      "source": "Meditations",
      "theme": ["thoughts", "character", "mindset"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA08",
      "quote": "It is not death that a man should fear, but he should fear never beginning to live.",
      "source": "Meditations",
      "theme": ["death", "courage", "living"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA09",
      "quote": "Accept the things to which fate binds you, and love the people with whom fate brings you together.",
      "source": "Meditations",
      "theme": ["acceptance", "love", "fate"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA10",
      "quote": "The object of life is not to be on the side of the majority, but to escape finding oneself in the ranks of the insane.",
      "source": "Meditations",
      "theme": ["independence", "thinking", "society"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA11",
      "quote": "Everything we hear is an opinion, not a fact. Everything we see is a perspective, not the truth.",
      "source": "Meditations",
      "theme": ["perspective", "truth", "judgment"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA12",
      "quote": "Never esteem anything as of advantage to you that will make you break your word or lose your self-respect.",
      "source": "Meditations",
      "theme": ["integrity", "honor", "character"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA13",
      "quote": "How much time he gains who does not look to see what his neighbor says or does or thinks.",
      "source": "Meditations",
      "theme": ["focus", "comparison", "discipline"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA14",
      "quote": "The impediment to action advances action. What stands in the way becomes the way.",
      "source": "Meditations",
      "theme": ["obstacles", "perseverance", "growth"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "MA15",
      "quote": "Look back over the past, with its changing empires that rose and fell, and you can foresee the future too.",
      "source": "Meditations",
      "theme": ["history", "perspective", "impermanence"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "MA16",
      "quote": "Dwell on the beauty of life. Watch the stars, and see yourself running with them.",
      "source": "Meditations",
      "theme": ["beauty", "wonder", "perspective"],
      "energy": "calm",
      "used": null
    }
  ],
  "seneca": [
    {
      "id": "SN01",
      "quote": "We suffer more often in imagination than in reality.",
      "source": "Letters to Lucilius",
      "theme": ["anxiety", "imagination", "suffering"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN02",
      "quote": "It is not that we have a short time to live, but that we waste a great deal of it.",
      "source": "On the Shortness of Life",
      "theme": ["time", "urgency", "discipline"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN03",
      "quote": "Luck is what happens when preparation meets opportunity.",
      "source": "Letters to Lucilius",
      "theme": ["preparation", "opportunity", "work"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN04",
      "quote": "Difficulties strengthen the mind, as labor does the body.",
      "source": "Moral Letters",
      "theme": ["hardship", "growth", "strength"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN05",
      "quote": "True happiness is to enjoy the present, without anxious dependence upon the future.",
      "source": "Letters to Lucilius",
      "theme": ["happiness", "present", "anxiety"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN06",
      "quote": "He who is brave is free.",
      "source": "Letters to Lucilius",
      "theme": ["courage", "freedom", "bravery"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN07",
      "quote": "Begin at once to live, and count each separate day as a separate life.",
      "source": "Moral Letters",
      "theme": ["urgency", "living", "present"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN08",
      "quote": "A gem cannot be polished without friction, nor a man perfected without trials.",
      "source": "Moral Letters",
      "theme": ["adversity", "growth", "perseverance"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN09",
      "quote": "No person has the power to have everything they want, but it is in their power not to want what they don't have.",
      "source": "Letters to Lucilius",
      "theme": ["desire", "contentment", "control"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN10",
      "quote": "As is a tale, so is life: not how long it is, but how good it is, is what matters.",
      "source": "Letters to Lucilius",
      "theme": ["life", "quality", "meaning"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN11",
      "quote": "Hang on to your youthful enthusiasms -- you'll be able to use them better when you're older.",
      "source": "Letters to Lucilius",
      "theme": ["aging", "enthusiasm", "growth"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN12",
      "quote": "Sometimes even to live is an act of courage.",
      "source": "Letters to Lucilius",
      "theme": ["courage", "suffering", "resilience"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "SN13",
      "quote": "Wealth consists not in having great possessions, but in having few wants.",
      "source": "Letters to Lucilius",
      "theme": ["wealth", "simplicity", "contentment"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "SN14",
      "quote": "If a man knows not to which port he sails, no wind is favorable.",
      "source": "Letters to Lucilius",
      "theme": ["purpose", "direction", "goals"],
      "energy": "intense",
      "used": null
    }
  ],
  "epictetus": [
    {
      "id": "EP01",
      "quote": "It's not what happens to you, but how you react to it that matters.",
      "source": "Discourses",
      "theme": ["reaction", "control", "mindset"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP02",
      "quote": "Man is not worried by real problems so much as by his imagined anxieties about real problems.",
      "source": "Enchiridion",
      "theme": ["anxiety", "perception", "worry"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP03",
      "quote": "First say to yourself what you would be; and then do what you have to do.",
      "source": "Discourses",
      "theme": ["action", "identity", "discipline"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "EP04",
      "quote": "No man is free who is not master of himself.",
      "source": "Discourses",
      "theme": ["freedom", "discipline", "self-control"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "EP05",
      "quote": "Wealth consists not in having great possessions, but in having few wants.",
      "source": "Discourses",
      "theme": ["wealth", "desire", "simplicity"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP06",
      "quote": "Only the educated are free.",
      "source": "Discourses",
      "theme": ["education", "freedom", "knowledge"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "EP07",
      "quote": "He is a drunkard who takes more than three glasses, though he be not drunk.",
      "source": "Discourses",
      "theme": ["moderation", "discipline", "excess"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP08",
      "quote": "If you want to improve, be content to be thought foolish and stupid.",
      "source": "Enchiridion",
      "theme": ["growth", "humility", "courage"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "EP09",
      "quote": "Don't explain your philosophy. Embody it.",
      "source": "Discourses",
      "theme": ["action", "authenticity", "virtue"],
      "energy": "intense",
      "used": null
    },
    {
      "id": "EP10",
      "quote": "Caretake this moment. Immerse yourself in its particulars.",
      "source": "Discourses",
      "theme": ["mindfulness", "present", "attention"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP11",
      "quote": "Other people's views and troubles can be contagious. Don't sabotage yourself by unwittingly adopting negative, unproductive attitudes.",
      "source": "Enchiridion",
      "theme": ["boundaries", "negativity", "influence"],
      "energy": "calm",
      "used": null
    },
    {
      "id": "EP12",
      "quote": "Make the best use of what is in your power, and take the rest as it happens.",
      "source": "Discourses",
      "theme": ["control", "acceptance", "action"],
      "energy": "calm",
      "used": null
    }
  ],
